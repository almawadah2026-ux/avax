# ══════════════════════════════════════════════════════════════════════
#  .env.example — القالب العام (يُدفع إلى git، بلا أسرار)
#  انسخه إلى `.env` واملأ القيم الحقيقية. ملف `.env` مستثنى من git.
# ══════════════════════════════════════════════════════════════════════

# ── CoinMarketCap ─────────────────────────────────────────────────────
# من: https://pro.coinmarketcap.com/account
CMC_API_KEY=

# ── Supabase ──────────────────────────────────────────────────────────
# الرابط الأساسي لمشروعك (بلا شرطة مائلة في النهاية)
SUPABASE_URL=
# المفتاح العام — آمن للواجهة الأمامية (محميّ بـRLS)
SUPABASE_PUBLISHABLE_KEY=
# مفتاح الخدمة — **سِرّ خطير، يتجاوز RLS**. للخلفية فقط، لا يُكشف أبداً.
SUPABASE_SERVICE_ROLE_KEY=
# رمز إدارة المشروع (CLI/Migrations) — سِرّ أيضاً
SUPABASE_ACCESS_TOKEN=

# ── GitHub ────────────────────────────────────────────────────────────
# Personal Access Token بصلاحية repo
GITHUB_TOKEN=
GITHUB_REPO_URL=

# ── الديسك ────────────────────────────────────────────────────────────
AVAX_DESK_CAPITAL=1000000
AVAX_DESK_JOURNAL_SECRET=
